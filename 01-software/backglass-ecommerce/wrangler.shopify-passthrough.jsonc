{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backglass-shopify-passthrough",
  "main": "./workers/shopify-passthrough.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "production": {
      "name": "backglass-shopify-passthrough-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "backglasspros.com/*",
          "zone_name": "backglasspros.com"
        },
        {
          "pattern": "www.backglasspros.com/*",
          "zone_name": "backglasspros.com"
        }
      ]
    }
  }
}
