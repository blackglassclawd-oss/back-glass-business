{%- comment -%}Replace product | structured_data inside its existing script tag; do not append duplicate Product schema. No inferred brand/manufacturer. Live Shopify commerce only.{%- endcomment -%}
{%- assign bgp_url = shop.url | append: product.url -%}
{%- capture bgp_json -%}
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": {{ bgp_url | append: '#product' | json }},
  "url": {{ bgp_url | json }},
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | json }},
  "productGroupID": {{ product.id | append: '' | json }},
  "hasVariant": [
    {%- for variant in product.variants -%}
      {%- assign variant_url = bgp_url | append: '?variant=' | append: variant.id -%}
      {
        "@type": "Product",
        "@id": {{ variant_url | append: '#variant' | json }},
        "name": {{ product.title | append: ' — ' | append: variant.title | json }},
        "url": {{ variant_url | json }},
        "isVariantOf": {"@id": {{ bgp_url | append: '#product' | json }}}
        {%- if variant.sku != blank -%},"sku": {{ variant.sku | json }}{%- endif -%}
        {%- assign bgp_image = variant.featured_image | default: product.featured_image -%}
        {%- if bgp_image -%}
          {%- assign bgp_image_url = bgp_image | image_url: width: 1600 -%}
          {%- assign bgp_image_prefix = bgp_image_url | slice: 0, 2 -%}
          {%- if bgp_image_prefix == '//' -%}{%- assign bgp_image_url = bgp_image_url | prepend: 'https:' -%}{%- endif -%}
          ,"image": {{ bgp_image_url | json }}
        {%- endif -%}
        {%- if variant.price > 0 -%}
        ,"offers": {
          "@type": "Offer",
          "url": {{ variant_url | json }},
          "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
        }
        {%- endif -%}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}
{%- capture bgp_lt -%}{% raw %}\u003c{% endraw %}{%- endcapture -%}
{{- bgp_json | replace: '<', bgp_lt -}}
